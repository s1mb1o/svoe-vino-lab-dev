[Unit]
Description=Что за вино administration web interface
After=network-online.target chto-za-vino-bot.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/projects/chto-za-vino-bot
EnvironmentFile=/home/ashmelev/.config/chto-za-vino-bot/env
ExecStart=/home/ashmelev/.venvs/chto-za-vino-bot/bin/chto-za-vino-admin
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/mnt/projects/chto-za-vino-bot/data

[Install]
WantedBy=default.target
