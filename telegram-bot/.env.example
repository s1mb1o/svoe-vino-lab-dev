# Local bare-process development example.
# Production uses Docker and the protected environment example at
# <workspace>/deploy/gx10/telegram-bot.env.example.

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_USER_ID=
BOT_ENVIRONMENT=development

# config.yaml reads these local service endpoints on gx10.
MODERATION_ENDPOINT=http://127.0.0.1:18081/upstream/shieldgemma-2-4b-it/classify
SAM3_ENDPOINT=http://192.168.86.14:18081/upstream/sam3
# The matcher endpoint /v1/match. The matcher returns the wine cards and selects the pipeline.
MATCHER_ENDPOINT=http://192.168.86.14:28000/v1/match

# Persistent data
BOT_DATA_ROOT=./data
BOT_DATABASE=./data/bot.sqlite3
BOT_REJECTION_IMAGE=./assets/content-rejected-monkey-640x640.png
BOT_DATA_RETENTION_DAYS=30

# Behavior
BOT_RATE_LIMIT=50
BOT_RATE_WINDOW_SECONDS=3600
BOT_QUEUE_WORKERS=1
BOT_QUEUE_CAPACITY=100
BOT_QUEUE_ESTIMATE_SECONDS=20
BOT_MAX_IMAGE_BYTES=20971520
BOT_MATCH_MIN_SCORE=0.70
BOT_MATCH_MIN_MARGIN=0.015
BOT_QUALITY_BLUR_MIN_VARIANCE=80
BOT_QUALITY_GLARE_MAX_RATIO=0.20
BOT_QUALITY_BOTTLE_MIN_AREA_RATIO=0.10
BOT_QUALITY_LABEL_MIN_AREA_RATIO=0.015
BOT_SYNC_PROFILE=true
BOT_LOG_LEVEL=INFO

# Internal synchronous recognition API. Generate a separate random token of at least 32 characters.
BOT_HTTP_API_TOKEN=
BOT_HTTP_API_HOST=127.0.0.1
BOT_HTTP_API_PORT=28002
BOT_HTTP_API_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
BOT_HTTP_API_RATE_LIMIT=10
BOT_HTTP_API_RATE_WINDOW_SECONDS=3600
BOT_HTTP_API_MAX_IN_FLIGHT=2

# Private administration web interface. Keep the listener on loopback.
# A non-loopback listener requires BOT_ADMIN_WEB_BEHIND_TLS_PROXY=true and a TLS proxy.
# Generate a random password with at least 32 characters.
BOT_ADMIN_WEB_USERNAME=admin
BOT_ADMIN_WEB_PASSWORD=
BOT_ADMIN_WEB_HOST=127.0.0.1
BOT_ADMIN_WEB_PORT=28003
BOT_ADMIN_WEB_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
BOT_ADMIN_WEB_BEHIND_TLS_PROXY=false
BOT_ADMIN_WEB_AUTH_RATE_LIMIT=10
BOT_ADMIN_WEB_AUTH_RATE_WINDOW_SECONDS=300
