# Account service settings. Copy to .env (development) or to the server env file (mode 0600).
# Generate each secret with: openssl rand -hex 32. All secrets must be distinct.

ACCOUNT_ENVIRONMENT=development
ACCOUNT_DATABASE=data/account.sqlite3
ACCOUNT_HOST=127.0.0.1
ACCOUNT_PORT=28008
# Client networks that may call the API (comma-separated CIDR).
ACCOUNT_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# Consumer bearer tokens. The bot tokens are optional.
ACCOUNT_WEB_TOKEN=
ACCOUNT_MAX_BOT_TOKEN=
ACCOUNT_TELEGRAM_BOT_TOKEN=
# HMAC key for email codes.
ACCOUNT_CODE_KEY=

# Versions of the texts that a person accepts at sign-up.
ACCOUNT_CONSENT_VERSION=2026-10-19
ACCOUNT_TERMS_VERSION=2026-10-19

# Email: smtp (production), console (development: prints codes to stderr), memory (tests).
ACCOUNT_EMAIL_BACKEND=console
ACCOUNT_EMAIL_FROM=noreply@chtozavino.ru
ACCOUNT_SITE_NAME=chtozavino.ru
SMTP_HOST=
SMTP_PORT=465
# ssl or starttls
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# Yandex ID. Leave YANDEX_CLIENT_ID empty to turn Yandex ID off.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Comma-separated; the Nuxt callback page(s).
YANDEX_REDIRECT_URIS=

# MAX mini app. MAX_WEBAPP_KEY = `chto-za-vino-account max-key` output (64 hex). Empty = off.
MAX_WEBAPP_KEY=
MAX_LOGIN_ENABLED=false
MAX_REQUIRE_IP_MATCH=true
MAX_INITDATA_MAX_AGE_SECONDS=300

# Telegram bot username for link deep links. Empty = Telegram linking off.
TELEGRAM_BOT_USERNAME=
