# Account service settings. Copy to .env (development) or to the server env file (mode 0600).
# Generate each secret with: openssl rand -hex 32. All secrets must be distinct.
# In a container, deploy/compose.example.yaml sets ACCOUNT_ENVIRONMENT, ACCOUNT_DATABASE,
# ACCOUNT_HOST, and ACCOUNT_PORT. The values of these four keys below are for development.

ACCOUNT_ENVIRONMENT=development
ACCOUNT_DATABASE=data/account.sqlite3
ACCOUNT_HOST=127.0.0.1
ACCOUNT_PORT=28008
# Client networks that may call the API (comma-separated CIDR). Development: loopback.
# In a container, callers on the same host arrive from Docker bridge addresses: use
# 172.16.0.0/12 on a default Docker install (see deploy/compose.example.yaml).
ACCOUNT_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# Consumer tokens: random secrets that you generate (openssl rand -hex 32).
# Each consumer has the same name and value in its own settings: ACCOUNT_WEB_TOKEN in the website,
# ACCOUNT_TELEGRAM_TOKEN in the Telegram bot, ACCOUNT_MAX_TOKEN in the MAX bot. They are NOT the
# bot tokens of Telegram or MAX: the service never gets those. The bot tokens are optional.
ACCOUNT_WEB_TOKEN=
ACCOUNT_MAX_TOKEN=
ACCOUNT_TELEGRAM_TOKEN=
# HMAC key for email codes.
ACCOUNT_CODE_KEY=

# Versions of the texts that a person accepts at sign-up.
ACCOUNT_CONSENT_VERSION=2026-10-19
ACCOUNT_TERMS_VERSION=2026-10-19

# Email: smtp (production), console (development: prints codes to stderr), memory (tests).
ACCOUNT_EMAIL_BACKEND=console
ACCOUNT_EMAIL_FROM=noreply@chtozavino.ru
ACCOUNT_SITE_NAME=chtozavino.ru
SMTP_HOST=
SMTP_PORT=465
# ssl or starttls
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# Yandex ID. Leave YANDEX_CLIENT_ID empty to turn Yandex ID off.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Comma-separated; the Nuxt server route, for example
# https://chtozavino.ru/api/account/yandex/callback
YANDEX_REDIRECT_URIS=

# MAX mini app. MAX_WEBAPP_KEY = `chto-za-vino-account max-key` output (64 hex). Empty = off.
MAX_WEBAPP_KEY=
MAX_LOGIN_ENABLED=false
MAX_REQUIRE_IP_MATCH=true
MAX_INITDATA_MAX_AGE_SECONDS=300

# Telegram bot username for link deep links. Empty = Telegram linking off.
TELEGRAM_BOT_USERNAME=
