{
  "name": "svoe-vino-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 8153",
    "build": "nuxt build",
    "start": "HOST=127.0.0.1 PORT=8153 node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:contract": "node scripts/check-contract.mjs",
    "test:pwa": "node scripts/check-pwa-browser.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.0",
    "vue-tsc": "^3.1.0"
  }
}
