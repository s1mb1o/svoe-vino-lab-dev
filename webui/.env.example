NUXT_PREDICTION_MODE=mock
# Use the complete prediction URL when the recognition API is ready.
# NUXT_PREDICTION_MODE=upstream
# NUXT_PREDICTION_ENDPOINT=http://127.0.0.1:8080/v1/eval/predict
# The same matcher origin provides /v1/group/match for shelf photos.

# Android landing page download settings.
# The local defaults use the versioned APK from ../android/app/build/outputs/apk/friendly/.
# NUXT_ANDROID_APK_PATH=/absolute/path/to/chtozavino-0.1.4-debug.apk
# NUXT_PUBLIC_ANDROID_APK_URL=/downloads/chtozavino-0.1.4-debug.apk

# Dinner Lens: private server settings. Never use NUXT_PUBLIC_ for these values.
NUXT_DINNER_LENS_ENDPOINT=
NUXT_DINNER_LENS_API_TOKEN=

# «Винный дневник» (docs/account.md). Empty endpoint: the account feature is off.
# NUXT_ACCOUNT_ENDPOINT=http://127.0.0.1:28008
# NUXT_ACCOUNT_TOKEN=<web consumer token of the account service, 32+ characters>
# NUXT_ACCOUNT_PUBLIC_ORIGIN=https://chtozavino.ru
# MAX mini app of the diary (docs/account.md, "MAX link"). Empty values turn the MAX link off.
# NUXT_ACCOUNT_MAX_APP_LINK=https://max.ru/<bot>?startapp=account
# NUXT_ACCOUNT_MAX_HOST=max.chtozavino.ru
