+def _convex_mask(grid):
+    """Fill enclosed paper/surface gaps without filling a rotated rectangle."""
+    im = Image.fromarray(grid.astype("uint8") * 255)
+    boundary = grid & ~(np.asarray(im.filter(ImageFilter.MinFilter(3))) > 0)
+    y, x = np.nonzero(boundary)
+    points = sorted(zip(x.tolist(), y.tolist()))
+
+    def cross(a, b, c):
+        return (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+
+    chains = []
+    for ordered in (points, reversed(points)):
+        chain = []
+        for point in ordered:
+            while len(chain) >= 2 and cross(chain[-2], chain[-1], point) <= 0:
+                chain.pop()
+            chain.append(point)
+        chains.append(chain[:-1])
+    hull = chains[0] + chains[1]
+    if len(hull) >= 3:
+        ImageDraw.Draw(im).polygon(hull, fill=255)
+    return im
+
