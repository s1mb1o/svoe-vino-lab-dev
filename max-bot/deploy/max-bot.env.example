# Template of config/max-bot.env for compose.example.yaml. Install it with mode 0600.
# Compose reads this file with format: raw. Do not quote values or expand variables.
# Replace each <...> value before the first start.
# The image sets /data, the container listeners, config.yaml, and the rejection illustration.

# Secrets. Make each random value separately, for example with `openssl rand -hex 32`.
MAX_BOT_TOKEN=
BOT_HTTP_API_TOKEN=
BOT_ADMIN_WEB_PASSWORD=
# The numeric MAX user ID of the administrator. It is not a secret.
BOT_ADMIN_USER_ID=

BOT_ENVIRONMENT=production
MAX_API_BASE_URL=https://platform-api2.max.ru
# Empty: the bundled Russian Trusted Root CA is added to the public trust store.
MAX_API_CA_FILE=
# Optional host suffixes for attachment downloads, for example oneme.ru,okcdn.ru.
MAX_MEDIA_ALLOWED_HOSTS=
MAX_POLL_TIMEOUT_SECONDS=30

# The model services and the matcher. In a container, 127.0.0.1 is the container itself:
# use an address that the container can reach.
MODERATION_ENDPOINT=http://<model-gateway-host>:<port>/upstream/shieldgemma-2-4b-it/classify
SAM3_ENDPOINT=http://<model-gateway-host>:<port>/upstream/sam3
MATCHER_ENDPOINT=http://<matcher-host>:<port>/v1/match

BOT_DATA_RETENTION_DAYS=30
BOT_RATE_LIMIT=50
BOT_RATE_WINDOW_SECONDS=3600
BOT_QUEUE_WORKERS=1
BOT_QUEUE_CAPACITY=100
BOT_QUEUE_ESTIMATE_SECONDS=20
BOT_MAX_IMAGE_BYTES=20971520
BOT_MATCH_MIN_SCORE=0.70
BOT_MATCH_MIN_MARGIN=0.015
BOT_QUALITY_BLUR_MIN_VARIANCE=80
BOT_QUALITY_GLARE_MAX_RATIO=0.20
BOT_QUALITY_BOTTLE_MIN_AREA_RATIO=0.10
BOT_QUALITY_LABEL_MIN_AREA_RATIO=0.015
BOT_SYNC_PROFILE=true
BOT_LOG_LEVEL=INFO

# The networks of the API clients, comma-separated CIDR. Add the LAN of the clients.
BOT_HTTP_API_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,<client-network-cidr>
BOT_HTTP_API_RATE_LIMIT=10
BOT_HTTP_API_RATE_WINDOW_SECONDS=3600
BOT_HTTP_API_MAX_IN_FLIGHT=2

BOT_ADMIN_WEB_USERNAME=admin
BOT_ADMIN_WEB_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
BOT_ADMIN_WEB_BEHIND_TLS_PROXY=false
BOT_ADMIN_WEB_AUTH_RATE_LIMIT=10
BOT_ADMIN_WEB_AUTH_RATE_WINDOW_SECONDS=300

# «Винный дневник» history records (plan 07). Empty BOT_ACCOUNT_ENDPOINT turns them off.
# The account service must be reachable from the container, for example
# http://<account-host>:<port>. ACCOUNT_MAX_TOKEN is a separate random secret with the same name
# and value in the account service. It is not MAX_BOT_TOKEN.
BOT_ACCOUNT_ENDPOINT=
ACCOUNT_MAX_TOKEN=
