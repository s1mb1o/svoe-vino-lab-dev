# Production environment of the «Что за вино?» MAX bot on gx10.
#
# Copy this file to /srv/svoe-vino-lab/prod/max-bot/config/max-bot.env and set mode 0600.
# Compose passes each line to both containers. Never commit the real file.
# Write each secret between single quotes, for example MAX_BOT_TOKEN='AbC...'. Compose expands
# $NAME in an unquoted or double-quoted value: it changes a secret that contains "$" and prints
# a part of it in a warning. A single-quoted value goes to the container unchanged.

# --- Secrets -------------------------------------------------------------------------------
# business.max.ru → Чат-боты → ⋮ → Настройки → token.
MAX_BOT_TOKEN=''
# The MAX user ID of the administrator. The bot shows it in the answer to /privacy.
BOT_ADMIN_USER_ID=
# A separate random value with at least 32 characters, for example: openssl rand -hex 32
BOT_HTTP_API_TOKEN=''
# A separate random value with at least 32 characters.
BOT_ADMIN_WEB_PASSWORD=''

# --- Environment ---------------------------------------------------------------------------
BOT_ENVIRONMENT=production

# --- Update delivery -----------------------------------------------------------------------
# updates.mode in config.yaml selects the update delivery. Production uses long polling during
# the hackathon (owner decision, issue #10). MAX recommends a webhook; the switch is issue #23.
MAX_POLL_TIMEOUT_SECONDS=30
# Webhook mode only (updates.mode: webhook). Also publish 127.0.0.1:28006:8081 in compose.yaml.
# MAX_WEBHOOK_URL=https://<public name>/max/webhook
# MAX_WEBHOOK_SECRET='<32 to 256 characters of A-Z a-z 0-9 _ ->'
# MAX_WEBHOOK_SUBSCRIBE=true

# --- MAX API -------------------------------------------------------------------------------
MAX_API_BASE_URL=https://platform-api2.max.ru
# Empty: the image adds the bundled Russian Trusted Root CA (Минцифры) to the public trust store.
MAX_API_CA_FILE=
# Optional host suffixes for attachment downloads, for example oneme.ru,okcdn.ru.
MAX_MEDIA_ALLOWED_HOSTS=

# --- Model services on gx10 ----------------------------------------------------------------
# In a container, 127.0.0.1 is the container itself. Use the LAN address of gx10.
MODERATION_ENDPOINT=http://192.168.86.14:18081/upstream/shieldgemma-2-4b-it/classify
SAM3_ENDPOINT=http://192.168.86.14:18081/upstream/sam3
MATCHER_ENDPOINT=http://192.168.86.14:28000/v1/match

# --- Data ----------------------------------------------------------------------------------
# The image sets BOT_DATA_ROOT=/data and BOT_REJECTION_IMAGE. Production requires 30 days.
BOT_DATA_RETENTION_DAYS=30

# --- Behavior (the same values as the Telegram bot) ----------------------------------------
BOT_RATE_LIMIT=50
BOT_RATE_WINDOW_SECONDS=3600
BOT_QUEUE_WORKERS=1
BOT_QUEUE_CAPACITY=100
BOT_QUEUE_ESTIMATE_SECONDS=20
BOT_MAX_IMAGE_BYTES=20971520
BOT_MATCH_MIN_SCORE=0.70
BOT_MATCH_MIN_MARGIN=0.015
BOT_QUALITY_BLUR_MIN_VARIANCE=80
BOT_QUALITY_GLARE_MAX_RATIO=0.20
BOT_QUALITY_BOTTLE_MIN_AREA_RATIO=0.10
BOT_QUALITY_LABEL_MIN_AREA_RATIO=0.015
BOT_SYNC_PROFILE=true
BOT_LOG_LEVEL=INFO

# --- Recognition HTTP API (container port 8080, published as 28004) ------------------------
BOT_HTTP_API_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,192.168.86.0/24
BOT_HTTP_API_RATE_LIMIT=10
BOT_HTTP_API_RATE_WINDOW_SECONDS=3600
BOT_HTTP_API_MAX_IN_FLIGHT=2

# --- Administration web interface (host loopback 127.0.0.1:28005, SSH tunnel) ---------------
BOT_ADMIN_WEB_USERNAME=admin
BOT_ADMIN_WEB_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
BOT_ADMIN_WEB_BEHIND_TLS_PROXY=false
BOT_ADMIN_WEB_AUTH_RATE_LIMIT=10
BOT_ADMIN_WEB_AUTH_RATE_WINDOW_SECONDS=300
