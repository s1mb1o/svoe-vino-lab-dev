# BuildKit reads this file for max-bot/Dockerfile only when the build context is a directory:
# compose.host-demo.yaml builds from the repository root. The image needs only im-core/ and
# max-bot/. A `git archive ... | docker build -` context does not use this file. That archive
# contains only committed files.
*
!im-core
!max-bot
**/.venv
**/.uv-cache
**/__pycache__
**/.pytest_cache
**/.ruff_cache
max-bot/data
